@using LabRobotica.ViewModels
@model LabRobotica.ViewModels.EmprestimoListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Empréstimos";
}

<style>
    body {
        background-color: #f4f5f7;
    }

    .card {
        border: none;
        border-radius: 8px;
    }

    .btn-purple {
        background-color: #9111ed;
        color: white;
    }
    .btn-purple:hover {
        background-color: #780ec5;
        color: white;
    }
</style>

<div id="NovoEmprestimo" tabindex="-1">
    <div class="card dialog dialog-centered">
        <div class="content rounded-3 border-0 shadow">
            
            <div class="header border-bottom-0 pt-4 px-4">
                <h5 class="title fw-semibold fs-4" id="NovoEmprestimoLabel">Novo Empréstimo</h5>
            </div>

            <div class="body px-4 pb-4">
                <form action="/Emprestimo/Insert" method="post">
                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium fs-5 mb-1">Nome do Aluno</label>
                            <input type="text" class="form-control" asp-for="Aluno" name="Aluno" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium fs-5 mb-1">Curso</label>
                            <input type="text" class="form-control" asp-for="Curso" name="Curso" required>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium fs-5 mb-1">Telefone</label>
                            <input type="text" class="form-control" asp-for="Telefone" name="Telefone" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium fs-5 mb-1">Email</label>
                            <input type="email" class="form-control" asp-for="Email" name="Email" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium fs-5 mb-1">Finalidade</label>
                        <select class="form-select" asp-for="Finalidade" name="Finalidade" required>
                            <option value="1" selected>Ensino</option>
                            <option value="2">Pesquisa</option>
                            <option value="3">Extensão</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium fs-5 mb-1">Item</label>
                        <select class="form-select" asp-for="EstoqueId" name="EstoqueId" required>
                            @if (Model.Estoques == null || Model.Estoques?.Count() == 0)
                            {
                                <option value="">Nenhum item disponível</option>
                            }
                            else
                            {
                                @foreach (EstoqueListViewModel item in Model.Estoques)
                                {
                                    <option value="@item.Id" data-quantidade="@item.QuantidadeDisponivel">@item.ItemNome</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-medium fs-5 mb-1">Quantidade Emprestada</label>
                            <input type="number" class="form-control" asp-for="QuantidadeEmprestada" name="QuantidadeEmprestada" value="1" min="1" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium fs-5 mb-1">Data de Retirada</label>
                            <input type="date" class="form-control" name="DataRetirada" value="@DateTime.Now.ToString("yyyy-MM-dd")" readonly required>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2">
                        <a href="/Emprestimo/List" class="btn btn-outline-secondary px-4 py-2 bg-white fw-medium text-dark border-secondary-subtle">Cancelar</a>
                        <button type="submit" class="btn btn-purple px-4 py-2 fw-medium">Cadastrar</button>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const selectItem = document.querySelector('select[name="EstoqueId"]');
            const inputQuantidade = document.querySelector('input[name="QuantidadeEmprestada"]');

            function atualizarQtdMaxima() {

                const opcaoSelecionada = selectItem.options[selectItem.selectedIndex];

                if (opcaoSelecionada) {
                    const qtdMaxima = opcaoSelecionada.getAttribute('data-quantidade');

                    if (qtdMaxima) {
                        inputQuantidade.setAttribute('max', qtdMaxima);

                        inputQuantidade.setAttribute('title', `Máximo disponível: ${qtdMaxima}`);

                        // Se o usuário já tiver digitado um número maior do que o novo máximo, o sistema reduz automaticamente para o teto permitido
                        if (parseInt(inputQuantidade.value) > parseInt(qtdMaxima)) {
                            inputQuantidade.value = qtdMaxima;
                        }
                    } else {
                        inputQuantidade.setAttribute('max', '0');
                        inputQuantidade.value = '0';
                    }
                }
            }

            selectItem.addEventListener('change', atualizarQtdMaxima);

            atualizarQtdMaxima();
        });
    </script>
}