@using LabRobotica.ViewModels
@model LabRobotica.ViewModels.MovimentacaoListViewModel;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card" style="background-color: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); border: 1px solid #e5e7eb;">
        <div class="header border-bottom-0 pt-4 px-4 align-items-start">
            <div>
                <h5 class="title fw-medium fs-2">Histórico de Movimentações</h5>
                <p class="text-muted fs-5 mb-0">@Model.NomeItemEstoque - @Model.MarcaItemEstoque</p>
            </div>
        </div>

        <div class="body px-4 pb-4">
            <div class="row p-3 mb-4 mx-0 rounded-3" style="background-color: #f4f8fc;">
                <div class="col-6">
                    <div class="text-muted fs-6 mb-1">Quantidade Total</div>
                    <div class="fs-5 text-dark">@Model.QuantidadeTotal</div>
                </div>
                <div class="col-6">
                    <div class="text-muted fs-6 mb-1">Quantidade Disponível</div>
                    <div class="fs-5 text-dark">@Model.QuantidadeDisponivel</div>
                </div>
            </div>

        <div class="table-responsive mb-4">
            <table class="table table-borderless text-center align-middle mb-0 fs-4">
                    <thead class="bg-light">
                        <tr>
                            <th scope="col" class="py-3 fw-medium small">Data</th>
                            <th scope="col" class="py-3 fw-medium small">Tipo</th>
                            <th scope="col" class="py-3 fw-medium small">Quantidade</th>
                            <th scope="col" class="py-3 fw-medium small text-start">Observação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (MovimentacaoListViewModel item in Model.List)
                        {
                                <tr>
                                    <td class="small">@(item.Data.ToString("dd/MM/yyyy") ?? "-")</td>
                                    @if (item.Tipo == 1) // Acréscimo
                                    {
                                        <td class="text-success small">
                                            <i class="bi bi-graph-up-arrow me-1"></i> Acréscimo
                                        </td>
                                        <td class="text-success small">+@item.QuantidadeMovimentada</td>
                                        <td class="small text-start">@item.Observacao</td>
                                    } // Decréscimo
                                    else {
                                        <td class="text-danger small">
                                            <i class="bi bi-graph-down-arrow me-1"></i> Decréscimo
                                        </td>
                                        <td class="text-danger small">@item.QuantidadeMovimentada</td>
                                        <td class="small text-start">@item.Observacao</td>
                                    }
                                </tr>              
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end">
                <a href="/Estoque/List" class="btn btn-outline-secondary px-4">Fechar</a>
            </div>
        </div>
</div>