@model LabRobotica.ViewModels.MovimentacaoListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card" style="background-color: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); border: 1px solid #e5e7eb;">
    <div class="header border-bottom-0 pt-4 px-4">
        <h5 class="title fw-medium fs-4">Registrar Movimentação</h5>
    </div>

    <div class="body px-4 pb-4">
        <div class="p-3 mb-4 rounded-3" style="background-color: #f4f8fc;">
            <div class="mb-1 text-dark">
                Quantidade Anterior: <strong class="text-dark">@Model.QuantidadeAnterior</strong>
            </div>
            @{
                var qtdTotal = Model.QuantidadeAnterior + Model.QuantidadeMovimentada;
            }
            <div class="mb-1 text-dark">
                Quantidade Atual: <strong class="text-dark">@qtdTotal</strong>
            </div>
            <div class="text-dark">
                Diferença:
                @if (Model.QuantidadeMovimentada > 0)
                {
                    <strong class="text-success">+@Model.QuantidadeMovimentada</strong>
                }
                else
                {
                    <strong class="text-danger">@Model.QuantidadeMovimentada</strong>
                }
            </div>
        </div>

        <form action="/Movimentacao/Insert" method="post">
            <input type="text" hidden asp-for="EstoqueId" name="EstoqueId" value="@Model.EstoqueId">
            <input type="text" hidden asp-for="QuantidadeMovimentada" name="QuantidadeMovimentada" value="@Model.QuantidadeMovimentada">
            @if (Model.QuantidadeMovimentada > 0)
            {
                <input type="text" hidden asp-for="Tipo" name="Tipo" value="1">
            }
            else
            {
                <input type="text" hidden asp-for="Tipo" name="Tipo" value="2">
            }

            <div class="mb-3">
                <label class="form-label fw-medium fs-6">Data</label>
                <input type="date" class="form-control" name="Data" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
            </div>

            <div class="mb-4">
                <label class="form-label fw-medium fs-6">Observação</label>
                <textarea class="form-control" asp-for="Observacao" name="Observacao" rows="3" placeholder="Descreva o motivo da movimentação"></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-success px-4">Confirmar</button>
            </div>
        </form>
    </div>
</div>