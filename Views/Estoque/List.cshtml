@model LabRobotica.ViewModels.EstoqueListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #f4f5f7;
    }

    .card {
        border: none;
        border-radius: 8px;
    }

    .table th {
        font-weight: 600;
        border-bottom-width: 1px;
    }

    .empty-state {
        color: #6c757d;
        padding: 40px 0;
    }
</style>

<div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h3 class="titulo-tela fs-2 fw-medium mb-0">Gestão de Estoque</h3>
        <a href="/Estoque/Insert" class="btn btn-success d-flex align-items-center gap-2 fs-5 fw-medium">
            <i class="fa-solid fa-plus"></i> Adicionar ao Estoque
        </a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small py-2 px-3 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Sucesso"]
            <button type="button" class="btn-close p-2 small" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small py-2 px-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Erro"]
            <button type="button" class="btn-close p-2 small" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtros de Pesquisa -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h6 class="card-title text-muted mb-3 fs-4 fw-medium">
                <i class="fa-solid fa-search"></i>  Filtros de Pesquisa
            </h6>

            <form method="get" asp-action="List" class="row g-3">
                <!-- Linha 1 -->
                <div class="col-md-4">
                    <label class="form-label text-muted small fw-medium mb-1 fs-5">Item</label>
                    <input type="text" id="filtroItem" name="pesquisaItem" class="form-control fs-5" placeholder="Buscar por item...">
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small fw-medium mb-1 fs-5">Quantidade Total</label>
                    <input type="text" id="filtroQuantidadeTotal" name="pesquisaQtdTotal" class="form-control fs-5" placeholder="Filtrar por quantidade...">
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small fw-medium mb-1 fs-5">Quantidade Disponível</label>
                    <input type="text" id="filtroQuantidadeDisponivel" name="pesquisaQtdDisponivel" class="form-control fs-5" placeholder="Filtrar por disponível...">
                </div>

                <!-- Linha 2 -->
                <div class="col-md-4">
                    <label class="form-label text-muted small fw-medium mb-1 fs-5">Tipo</label>
                    <select id="filtroTipoItem" name="pesquisaTipo" class="form-select fs-5">
                        <option value="0" selected>Todos</option>
                        <option value="1">Componente Eletrônico</option>
                        <option value="2">Equipamentos</option>
                        <option value="3">Outros</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small fw-medium mb-1 fs-5">Data Compra</label>
                    <input type="date" id="filtroDataCompra" name="pesquisaDataCompra" class="form-control fs-5">
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small fw-medium mb-1 fs-5">Data Última Entrada</label>
                    <input type="date" id="filtroDataUltEntrada" name="pesquisaUltimaEntrada" class="form-control fs-5">
                </div>

                <!-- Botão oculto para submeter os filtros ao apertar Enter -->
                <button type="submit" class="d-none"></button>
            </form>
        </div>
    </div>

    <!-- Tabela de Dados -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-borderless mb-0 text-center align-middle fs-5">
                    <thead class="bg-light">
                        <tr>
                            <th scope="col" class="py-3">Item</th>
                            <th scope="col" class="py-3">Marca</th>
                            <th scope="col" class="py-3">Qtd. Total</th>
                            <th scope="col" class="py-3">Qtd. Disponível</th>
                            <th scope="col" class="py-3">Data Compra</th>
                            <th scope="col" class="py-3">Última Entrada</th>
                            <th scope="col" class="py-3">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.List.Any())
                        {
                            <tr>
                                <td colspan="7" class="empty-state text-muted py-4">
                                    Nenhum item no estoque
                                </td>
                            </tr>
                        } 
                        else
                        {
                            <tr id="linhaSemResultados" style="display: none;">
                                <td colspan="7" class="empty-state text-muted py-4">
                                    Nenhum item corresponde aos filtros pesquisados
                                </td>
                            </tr>
                            @foreach (var item in Model.List)
                            {
                                <tr class="estoque-row"
                                    data-item="@item.ItemNome.ToLower()"
                                    data-qtdtotal="@item.QuantidadeTotal"
                                    data-qtddisponivel="@item.QuantidadeDisponivel"
                                    data-tipoitem="@item.ItemTipo"
                                    data-dtacompra="@item.DataCompra.ToString("yyyy-MM-dd")"
                                    data-dtaultentrada="@item.DataUltimaEntrada.ToString("yyyy-MM-dd")">
                                    <td class="fw-medium">@item.ItemNome</td>
                                    <td>@item.ItemMarca</td>
                                    <td>@item.QuantidadeTotal</td>
                                    <td>
                                        <!-- Exemplo de formatação condicional (opcional) -->
                                        <span class="badge @(item.QuantidadeDisponivel > 0 ? "bg-success" : "bg-danger")">
                                            @item.QuantidadeDisponivel
                                        </span>
                                    </td>
                                    <td>@(item.DataCompra.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td>@(item.DataUltimaEntrada.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td>
                                        <a href="/Estoque/Edit/@item.Id" class="text-primary text-decoration-none me-2" title="Editar">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                        <a href="/Movimentacao/List/@item.Id" class="text-primary text-decoration-none me-2" title="Ver histórico">
                                            <i class="fa-solid fa-clock-rotate-left"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const inputItem = document.getElementById('filtroItem');
            const inputQtdTotal = document.getElementById('filtroQuantidadeTotal');
            const inputQtdDisponivel = document.getElementById('filtroQuantidadeDisponivel');
            const selectTipoItem = document.getElementById('filtroTipoItem');
            const inputDataCompra = document.getElementById('filtroDataCompra');
            const inputDataUltEntrada = document.getElementById('filtroDataUltEntrada');

            const linhas = document.querySelectorAll('.estoque-row');
            const linhaSemResultados = document.getElementById('linhaSemResultados');

            function filtrarTabela() {
                const valorItem = inputItem.value.toLowerCase().trim();
                const valorQtdTotal = inputQtdTotal.value.trim();
                const valorQtdDisponivel = inputQtdDisponivel.value.trim();
                const valorTipoItem = selectTipoItem.value;
                const valorDataCompra = inputDataCompra.value;
                const valorDataUltEntrada = inputDataUltEntrada.value;

                let linhasVisiveis = 0;

                linhas.forEach(function (linha) {
                    const nomeItem = linha.getAttribute('data-item') || '';
                    const qtdTotal = linha.getAttribute('data-qtdtotal') || '';
                    const qtdDisponivel = linha.getAttribute('data-qtddisponivel') || '';
                    const tipoItem = linha.getAttribute('data-tipoitem') || '';
                    const dataCompra = linha.getAttribute('data-dtacompra') || '';
                    const dataUltEntrada = linha.getAttribute('data-dtaultentrada') || '';

                    const bateItem = nomeItem.includes(valorItem);
                    const bateQtdTotal = (valorQtdTotal === '' || qtdTotal === valorQtdTotal);
                    const bateQtdDisponivel = (valorQtdDisponivel === '' || qtdDisponivel === valorQtdDisponivel);
                    const bateTipoItem = (valorTipoItem === '0' || tipoItem === valorTipoItem);
                    const bateDataCompra = (valorDataCompra === '' || dataCompra === valorDataCompra);
                    const bateDataUltEntrada = (valorDataUltEntrada === '' || dataUltEntrada === valorDataUltEntrada);

                    if (bateItem && bateQtdTotal && bateQtdDisponivel && bateTipoItem && bateDataCompra && bateDataUltEntrada) {
                        linha.style.display = '';
                        linhasVisiveis++;
                    } else {
                        linha.style.display = 'none';
                    }
                });

                if (linhaSemResultados) {
                    if (linhasVisiveis === 0 && linhas.length > 0) {
                        linhaSemResultados.style.display = '';
                    } else {
                        linhaSemResultados.style.display = 'none';
                    }
                }
            }

            inputItem.addEventListener('input', filtrarTabela);
            inputQtdTotal.addEventListener('input', filtrarTabela);
            inputQtdDisponivel.addEventListener('input', filtrarTabela);
            selectTipoItem.addEventListener('change', filtrarTabela);
            inputDataCompra.addEventListener('change', filtrarTabela);
            inputDataUltEntrada.addEventListener('change', filtrarTabela);
        });
    </script>
}
