@using LabRobotica.ViewModels
@model LabRobotica.ViewModels.EstoqueListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #f4f5f7;
    }

    .card {
        border: none;
        border-radius: 8px;
    }
</style>

<div id="NovoEstoque" tabindex="-1">
    <div class="card dialog dialog-centered">
        <div class="content border-0 shadow">
            <div class="header border-bottom-0 pt-4 px-4">
                <h5 class="title fw-semibold fs-4" id="NovoEstoqueLabel">Editar Estoque</h5>
            </div>
            <div class="body px-4 pb-4">

                <form action="/Estoque/Edit" method="post">
                    <input type="text" hidden asp-for="Id" name="Id" value="@Model.Id">
                    <div class="mb-3">
                        <label class="form-label fw-medium fs-5" asp-for="ItemId">Tipo</label>
                        <select class="form-select" asp-for="ItemId" name="ItemId" disabled>
                            <option value="@Model.ItemId">@Model.ItemNome</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium fs-5" asp-for="QuantidadeTotal">Quantidade</label>
                        @{
                            var quantidadeMinima = Model.QuantidadeTotal - Model.QuantidadeDisponivel;
                        }
                        <input type="number" class="form-control" asp-for="QuantidadeTotal" name="QuantidadeTotal" value="@Model.QuantidadeTotal" min="@quantidadeMinima" required>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Estoque/List" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Salvar</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

