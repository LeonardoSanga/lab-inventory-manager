@model LabRobotica.ViewModels.UsuarioListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Novo Usuário";
}

<style>
    body {
        background-color: #f4f5f7;
    }

    .card {
        border: none;
        border-radius: 8px;
    }
</style>

<div id="NovoUsuario" tabindex="-1">
    <div class="card dialog dialog-centered mx-auto" style="max-width: 480px;">
        <div class="content border-0 shadow">
            <div class="header border-bottom-0 pt-4 px-4">
                <h5 class="title fw-semibold fs-4" id="NovoUsuarioLabel">Novo Usuário</h5>
                <p class="text-muted small mb-0">Somente administradores podem cadastrar novos usuários. Esta ação será registrada no log de auditoria.</p>
            </div>
            <div class="body px-4 pb-4 pt-3">

                <form action="/Usuario/Insert" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-medium fs-5" asp-for="Login">Login</label>
                        <input type="text" class="form-control" asp-for="Login" name="Login" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium fs-5" asp-for="Senha">Senha</label>
                        <input type="password" class="form-control" asp-for="Senha" name="Senha" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium fs-5" asp-for="ConfirmarSenha">Confirmar Senha</label>
                        <input type="password" class="form-control" asp-for="ConfirmarSenha" name="ConfirmarSenha" required>
                    </div>
                    <div class="mb-4 form-check">
                        <input type="checkbox" class="form-check-input" asp-for="Administrador" name="Administrador" value="true">
                        <input type="hidden" name="Administrador" value="false">
                        <label class="form-check-label fw-medium fs-5" asp-for="Administrador">
                            Conceder privilégios de administrador
                        </label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Usuario/List" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Cadastrar</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
