@model LabRobotica.ViewModels.LogAuditoriaListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Logs de Auditoria";
}

<style>
    body {
        background-color: #f4f5f7;
    }

    .card {
        border: none;
        border-radius: 8px;
    }

    .table th {
        font-weight: 600;
        border-bottom-width: 1px;
    }

    .empty-state {
        color: #6c757d;
        padding: 40px 0;
    }
</style>

<div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h3 class="fw-medium mb-0 fs-2">Logs de Auditoria</h3>

        <a href="/Usuario/List" class="btn btn-outline-secondary d-flex align-items-center gap-2 fs-5 fw-medium">
            <i class="fa-solid fa-arrow-left"></i> Voltar para Usuários
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-borderless mb-0 text-center fs-5">
                    <thead class="bg-light">
                        <tr>
                            <th scope="col" class="py-3">Data/Hora</th>
                            <th scope="col" class="py-3">Responsável</th>
                            <th scope="col" class="py-3">Ação</th>
                            <th scope="col" class="py-3 text-start">Detalhes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.List == null || !Model.List.Any())
                        {
                            <tr>
                                <td colspan="4" class="empty-state text-muted py-4">
                                    Nenhum registro de auditoria encontrado
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in Model.List)
                            {
                                <tr>
                                    <td>@log.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@log.UsuarioResponsavelLogin</td>
                                    <td>@log.Acao</td>
                                    <td class="text-start" style="white-space: normal; word-break: break-word;">@(log.Detalhes ?? "-")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
