# Copie este arquivo para ".env" e troque TODAS as senhas antes de subir.
#   cp .env.example .env

# Porta em que o sistema ficará acessível no servidor (http://IP-DO-SERVIDOR:8080)
APP_PORT=8080

# Banco de dados (MySQL roda em container, não fica exposto na rede)
MYSQL_DATABASE=LabRoboticaDB
MYSQL_USER=labrobotica
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Administrador criado automaticamente na primeira inicialização
# (só é criado se não existir nenhum administrador ativo no banco)
ADMIN_LOGIN=admin
ADMIN_SENHA=troque-esta-senha-admin
